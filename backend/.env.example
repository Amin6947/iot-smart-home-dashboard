# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)

# สุ่มด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# บัญชีเจ้าของบ้าน (ใช้ login เข้า dashboard)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# กุญแจลับที่ ESP32 ต้องแนบมาใน header X-Device-Key ตอนส่ง telemetry
DEVICE_API_KEY=change-me-to-a-random-string

# โดเมนจริงของ frontend ที่ deploy แล้ว (สำหรับ CORS)
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# Postgres connection string จาก Render (ไม่ต้องตั้งถ้ารัน local จะใช้ SQLite อัตโนมัติ)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
